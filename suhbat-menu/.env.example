# Copy to .env.local for local development, and set the same values in the hosting
# provider's environment variables for production.

# bcrypt hash of the single shared admin password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-password"
#
# In THIS FILE and in .env.local the dollar signs must be escaped — write it as
#   ADMIN_PASSWORD_HASH=\$2b\$10\$xxxxxxxx...
# because Next's env-file loader reads an unescaped `$2b` as a variable reference
# and would leave you with a truncated hash.
#
# In a hosting provider's environment-variable UI (Vercel and friends) paste the
# RAW hash with no backslashes. That loader doesn't run there, so the backslashes
# would survive into the value, and bcrypt returns false for a hash it cannot
# parse — meaning the correct password is rejected with "Noto'g'ri parol" in
# production while it still works locally. lib/auth.ts now detects this and says
# so instead of failing silently.
ADMIN_PASSWORD_HASH=

# Signing key for the admin session cookie. At least 32 characters — lib/session.ts
# refuses to start with anything shorter. Generate one with: openssl rand -hex 32
SESSION_SECRET=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser: it bypasses row-level security and is
# what writes dishes, uploads photos, and stores the selected theme.
SUPABASE_SERVICE_ROLE_KEY=
